// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StudentRole {
  student
  admin
}

// 1. Usuário (Estudante)
model Student {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         StudentRole @default(student)
  phone        String?
  bio          String?
  avatarFileId String?     @unique
  hype         Int         @default(0) // Pode ser usado para gamificação do usuário
  courseId     String?

  // Relações
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  avatarFile StoredFile? @relation("StudentAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  posts      Post[]
  votes      Vote[]
  comments   Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

// 2. Curso
model Course {
  id       String  @id @default(uuid())
  name     String
  nameKey  String
  bio      String?
  avatarFileId String? @unique
  isActive Boolean @default(true)
  isSystem Boolean @default(false)

  // Relações
  students Student[]
  subjects SubjectCourse[]
  avatarFile StoredFile? @relation("CourseAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nameKey, isActive])
}

// 3. Matéria (Disciplina)
model Subject {
  id       String  @id @default(uuid())
  name     String
  nameKey  String
  isActive Boolean @default(true)

  // Relações
  courses SubjectCourse[]
  posts   Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 4. Tabela Intermediária (Muitos-para-Muitos entre Curso e Matéria)
model SubjectCourse {
  id             String @id @default(uuid())
  subjectId      String
  courseId       String
  subjectNameKey String

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([subjectId, courseId]) // Garante que não haja duplicatas da mesma matéria no mesmo curso
  @@unique([courseId, subjectNameKey])
  @@index([courseId])
}

// 5. Post (O material compartilhado)
model Post {
  id        String  @id @default(uuid())
  title     String
  subtitle  String?
  content   Json?
  studentId String
  subjectId String

  // Relações
  student      Student      @relation(fields: [studentId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  attachments  Attachment[]
  votes        Vote[]
  comments     Comment[]
  commentCount Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId, createdAt])
  @@index([studentId, createdAt])
}

// 6. Comentarios em posts
model Comment {
  id        String  @id @default(uuid())
  postId    String
  studentId String
  parentId  String?
  content   String

  post        Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id])
  parent      Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]    @relation("CommentReplies")
  votes       Vote[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, parentId, createdAt])
  @@index([studentId, createdAt])
}

// 6. Anexos
model Attachment {
  id           String  @id @default(uuid())
  postId       String?
  commentId    String?
  storedFileId String

  post       Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  storedFile StoredFile @relation(fields: [storedFileId], references: [id])

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([commentId])
  @@index([storedFileId])
}

// 7. Arquivo armazenado
model StoredFile {
  id           String   @id @default(uuid())
  originalName String
  storedName   String   @unique
  path         String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  attachments Attachment[]
  avatarOwner Student?     @relation("StudentAvatar")
  courseAvatarOwner Course? @relation("CourseAvatar")
}

// 8. Sistema de Votos (Upvote/Downvote)
model Vote {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  vote_type Int // 1 para Up, -1 para Down
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student  @relation(fields: [userId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId]) // Garante que um aluno vote apenas uma vez por post
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
  @@index([userId, createdAt])
}
